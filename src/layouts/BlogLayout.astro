---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "鶴岡純子のブログ。Web制作、ローカライズ、日々の学びを発信します。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        --background: #fafafa;
        --surface: #ffffff;
        --text: #222222;
        --muted: #666666;
        --border: #e5e5e5;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: var(--text);
        background: var(--background);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Hiragino Sans", "Noto Sans JP", sans-serif;
        line-height: 1.8;
      }

      a {
        color: inherit;
      }

      .blog-header {
        border-bottom: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.95);
      }

      .blog-header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: min(880px, calc(100% - 40px));
        min-height: 64px;
        margin: 0 auto;
      }

      .blog-site-title {
        font-weight: 700;
        text-decoration: none;
      }

      .blog-nav {
        display: flex;
        gap: 20px;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .blog-nav a {
        text-decoration: none;
      }

      .blog-nav a:hover {
        color: var(--text);
      }

      .blog-main {
        width: min(880px, calc(100% - 40px));
        min-height: calc(100vh - 145px);
        margin: 0 auto;
        padding: 64px 0 80px;
      }

      .blog-footer {
        padding: 28px 20px;
        border-top: 1px solid var(--border);
        color: #888888;
        text-align: center;
        font-size: 0.85rem;
      }

      @media (max-width: 600px) {
        .blog-header-inner {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
          padding: 14px 0;
        }

        .blog-main {
          padding-top: 40px;
        }
      }
    </style>
  </head>
  <body>
    <header class="blog-header">
      <div class="blog-header-inner">
        <a class="blog-site-title" href="/">Junko Tsuruoka</a>
        <nav class="blog-nav" aria-label="メインナビゲーション">
          <a href="/">Portfolio</a>
          <a href="/blog">Blog</a>
        </nav>
      </div>
    </header>

    <main class="blog-main">
      <slot />
    </main>

    <footer class="blog-footer">
      &copy; {new Date().getFullYear()} Junko Tsuruoka
    </footer>
  </body>
</html>
