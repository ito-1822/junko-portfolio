---
const apiUrl = "https://" + "junko.microcms.io/api/v1/works";
const response = await fetch(apiUrl, {
  headers: {
    "X-MICROCMS-API-KEY": import.meta.env.MICROCMS_API_KEY,
  },
});

const rawText = await response.text();
let works = [];
try {
  const data = JSON.parse(rawText);
  works = data.contents || [];
} catch (e) {
  works = [];
}

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Junko Tsuruoka | Japanese Localization & Web Production</title>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
    <style>
      :root {
        --bg: #fafafa;
        --card-bg: #ffffff;
        --text: #222222;
        --muted: #666666;
        --border: #e5e5e5;
        --accent: #1a1a1a;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Sans", "Noto Sans JP", sans-serif;
        color: var(--text);
        background-color: var(--bg);
        line-height: 1.75;
        margin: 0;
        padding: 0;
      }
      .site-header {
        position: sticky;
        top: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--border);
        z-index: 100;
      }
      .header-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
      }
      .site-logo {
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        color: var(--text);
        letter-spacing: 0.02em;
      }
      .nav-group {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .nav-links {
        display: flex;
        gap: 18px;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .nav-links a {
        text-decoration: none;
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
      }
      .nav-links a:hover {
        color: var(--text);
      }
      .lang-toggle {
        display: inline-flex;
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        background: #f2f2f2;
      }
      .lang-btn {
        border: none;
        background: transparent;
        padding: 4px 12px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        color: var(--muted);
        transition: all 0.2s;
      }
      .lang-btn.active {
        background: var(--accent);
        color: #ffffff;
      }
      .container {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 20px;
      }
      section {
        padding: 64px 0;
        border-bottom: 1px solid var(--border);
      }
      section:last-of-type {
        border-bottom: none;
      }
      .hero {
        padding: 80px 0 72px 0;
      }
      .hero-eyebrow {
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--muted);
        text-transform: uppercase;
        margin-bottom: 12px;
      }
      .hero h1 {
        font-size: 2rem;
        line-height: 1.35;
        margin: 0 0 20px 0;
        font-weight: 700;
      }
      .hero-desc {
        font-size: 1.05rem;
        color: var(--muted);
        max-width: 680px;
        margin: 0 0 32px 0;
      }
      .btn-primary {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: 6px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: opacity 0.2s;
      }
      .btn-primary:hover {
        opacity: 0.85;
      }
      .section-title {
        font-size: 1.4rem;
        margin: 0 0 32px 0;
        font-weight: 700;
        letter-spacing: 0.02em;
      }
      .work-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 32px;
        margin-bottom: 36px;
      }
      .work-title {
        font-size: 1.25rem;
        margin: 0 0 24px 0;
        border-left: 4px solid var(--accent);
        padding-left: 12px;
      }
      .comparison-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 28px;
      }
      @media (max-width: 768px) {
        .comparison-grid {
          grid-template-columns: 1fr;
        }
        .hero h1 {
          font-size: 1.55rem;
        }
      }
      .lang-label {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: bold;
        letter-spacing: 0.05em;
        color: #555;
        background: #f0f0f0;
        padding: 2px 8px;
        border-radius: 4px;
        margin-bottom: 12px;
      }
      .work-image {
        display: block;
        width: auto;
        max-width: 100%;
        max-height: 260px;
        height: auto;
        border: 1px solid #eee;
        border-radius: 4px;
        margin: 0 auto 14px auto;
      }
      .work-text {
        font-size: 0.95rem;
        white-space: pre-wrap;
        margin: 0;
      }
      .about-box {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 32px;
      }
      .about-box h3 {
        margin: 0 0 12px 0;
        font-size: 1.15rem;
      }
      .about-box p {
        margin: 0;
        color: var(--muted);
      }
      .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
      }
      .skill-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 24px;
      }
      .skill-card h3 {
        margin: 0 0 10px 0;
        font-size: 1.05rem;
      }
      .skill-card p {
        margin: 0;
        font-size: 0.92rem;
        color: var(--muted);
      }
      .contact-box {
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 40px 24px;
        text-align: center;
      }
      .contact-box p {
        max-width: 560px;
        margin: 0 auto 24px auto;
        color: var(--muted);
      }
      .contact-form {
        max-width: 620px;
        margin: 32px auto 0;
        text-align: left;
      }
      .form-field {
        margin-bottom: 20px;
      }
      .form-field label {
        display: block;
        margin-bottom: 7px;
        font-size: 0.9rem;
        font-weight: 600;
      }
      .form-field input,
      .form-field textarea {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: #fff;
        color: var(--text);
        font: inherit;
      }
      .form-field textarea {
        min-height: 180px;
        resize: vertical;
      }
      .form-field input:focus,
      .form-field textarea:focus {
        border-color: #777;
        outline: 2px solid rgba(0, 0, 0, 0.08);
        outline-offset: 1px;
      }
      .form-honeypot {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      .cf-turnstile {
        margin: 8px 0 20px;
      }
      .contact-submit {
        border: 0;
        cursor: pointer;
      }
      .contact-submit:disabled {
        cursor: wait;
        opacity: 0.55;
      }
      .form-status {
        min-height: 1.75em;
        margin: 14px 0 0 !important;
        text-align: left;
      }
      .form-status.success {
        color: #176b36;
      }
      .form-status.error {
        color: #a12622;
      }
      footer {
        text-align: center;
        color: #888;
        font-size: 0.85rem;
        padding: 40px 20px;
      }
      body.lang-en .ja { display: none; }
      body.lang-ja .en { display: none; }
    </style>
  </head>
  <body class="lang-en">
    <header class="site-header">
      <div class="header-inner">
        <a href="#" class="site-logo">Junko Tsuruoka</a>
        <div class="nav-group">
          <ul class="nav-links">
            <li><a href="#works">Works</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
          <div class="lang-toggle" role="group" aria-label="Language switch">
            <button type="button" class="lang-btn active" id="btn-en" onclick="setLang('en')">EN</button>
            <button type="button" class="lang-btn" id="btn-ja" onclick="setLang('ja')">JP</button>
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      <section class="hero">
        <div class="hero-eyebrow">Japanese Localization & Web Production</div>
        <h1>
          <span class="en">Web Production & Localization<br />Tailored for the Japanese Market</span>
          <span class="ja">日本に興味のある海外企業・個人事業主様へ<br />日本人へ自然に響くWeb制作・ローカライズ</span>
        </h1>
        <p class="hero-desc">
          <span class="en">
            I help global brands, independent creators, and businesses enter Japan with culturally natural Japanese copy, UI localization, and clean web design.
          </span>
          <span class="ja">
            直訳ではない「日本の商習慣や感性に合った日本語表現」と、信頼感を与えるWebデザインで、海外サービスの日本展開をサポートします。
          </span>
        </p>
        <a href="#works" class="btn-primary">
          <span class="en">View Works</span>
          <span class="ja">制作実績を見る</span>
        </a>
      </section>

      <section id="works">
        <h2 class="section-title">Works <span style="font-size:0.9rem; font-weight:normal; color:#666;">/ 制作実績</span></h2>
        {works.length === 0 ? (
          <p style="color: var(--muted);">
            <span class="en">Works will be published soon.</span>
            <span class="ja">制作実績を準備中です。</span>
          </p>
        ) : (
          works.map((item) => (
            <article class="work-card">
              <h3 class="work-title">{item.title}</h3>
              <div class="comparison-grid">
                <div>
                  <span class="lang-label">SOURCE COPY / EN</span>
                  {item.image_en && (
                    <img src={item.image_en.url} alt={`${item.title} English`} class="work-image" />
                  )}
                  <p class="work-text">{item.text_en}</p>
                </div>
                <div>
                  <span class="lang-label">JAPANESE LOCALIZED / JA</span>
                  {item.image_ja && (
                    <img src={item.image_ja.url} alt={`${item.title} Japanese`} class="work-image" />
                  )}
                  <p class="work-text">{item.text_ja}</p>
                </div>
              </div>
            </article>
          ))
        )}
      </section>

            <section id="about">
        <h2 class="section-title">About <span style="font-size:0.9rem; font-weight:normal; color:#666;">/ 自己紹介</span></h2>
        <div class="about-box">
          <h3>
            <span class="en">Bridging Global Services & Japanese Users</span>
            <span class="ja">海外サービスと日本のユーザーをつなぐWebクリエイター</span>
          </h3>
          <p>
            <span class="en">Based in Japan, I specialize in localizing websites and digital products for the Japanese market. I refine copy, layout, and UX so your business communicates clearly and persuasively to Japanese customers.</span>
            <span class="ja">日本を拠点に、海外企業や個人事業主様のWebサイト・サービスの日本向けローカライズとWeb制作を行っています。不自然な日本語を解消し、日本のユーザーに信頼されるデザインと言葉選びで日本市場での信頼獲得をサポートします。</span>
          </p>
          <h4>
            <span class="en">Independent Portfolio Projects</span>
            <span class="ja">自主制作サンプルについて</span>
          </h4>
          <p>
            <span class="en">All works featured on this website are independently created portfolio samples demonstrating web production and localization skills.<br>
             The product images, labels, and product names are fictional and were created specifically for this project. They are not associated with any real company, brand, or product.</span>
            <span class="ja">このWebサイトに掲載している制作物は、Web制作・ローカライズのスキルを示す自主制作のサンプルです。<br>
            サンプル名・ラベル・サンプル画像は架空のものであり、実在する企業・ブランド・商品とは一切関係ありません。</span>
　　      </p>
        </div>
      </section>

      <section id="skills">
        <h2 class="section-title">Skills <span style="font-size:0.9rem; font-weight:normal; color:#666;">/ スキル</span></h2>
        <div class="skills-grid">
          <div class="skill-card">
            <h3>
              <span class="en">Japanese Localization & Copywriting</span>
              <span class="ja">日英ローカライズ・ライティング</span>
            </h3>
            <p>
              <span class="en">Natural English-to-Japanese transcreation tailored to Japanese business etiquette.</span>
              <span class="ja">日本の商習慣やターゲット層に合わせた、違和感のない自然な日本語表現・コピーライティング。</span>
            </p>
          </div>
          <div class="skill-card">
            <h3>
              <span class="en">Web Design & UI Optimization</span>
              <span class="ja">Webデザイン・UI調整</span>
            </h3>
            <p>
              <span class="en">Typography, spacing, and layout adjustments optimized for Japanese readability.</span>
              <span class="ja">日本語特有のフォントや文字組みに配慮し、日本のユーザーに信頼感を与えるレイアウト設計。</span>
            </p>
          </div>
          <div class="skill-card">
            <h3>
              <span class="en">Modern Web Development</span>
              <span class="ja">高速Webサイト実装・CMS構築</span>
            </h3>
            <p>
              <span class="en">HTML/CSS, JavaScript, Astro, microCMS, and Cloudflare deployment for fast websites.</span>
              <span class="ja">Astro・microCMS・Cloudflareを用いた、表示速度が速く更新しやすいWebサイト構築。</span>
            </p>
          </div>
        </div>
      </section>

      <section id="contact">
        <h2 class="section-title">Contact <span style="font-size:0.9rem; font-weight:normal; color:#666;">/ お問い合わせ</span></h2>
        <div class="contact-box">
          <p>
            <span class="en">Interested in localizing your website or launching your service in Japan? Please send your inquiry using the form below.</span>
            <span class="ja">Webサイトの日本語化や日本向けLP制作のご相談・お見積もりなど、以下のフォームからお気軽にお問い合わせください。</span>
          </p>
          <form id="contact-form" class="contact-form">
            <div class="form-field">
              <label for="contact-name">
                <span class="en">Name</span>
                <span class="ja">お名前</span>
              </label>
              <input id="contact-name" name="name" type="text" maxlength="100" autocomplete="name" required />
            </div>

            <div class="form-field">
              <label for="contact-email">
                <span class="en">Email address</span>
                <span class="ja">メールアドレス</span>
              </label>
              <input id="contact-email" name="email" type="email" maxlength="254" autocomplete="email" required />
            </div>

            <div class="form-field">
              <label for="contact-message">
                <span class="en">Message</span>
                <span class="ja">お問い合わせ内容</span>
              </label>
              <textarea id="contact-message" name="message" maxlength="5000" required></textarea>
            </div>

            <div class="form-honeypot" aria-hidden="true">
              <label for="contact-website">Website</label>
              <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>

            <button id="contact-submit" type="submit" class="btn-primary contact-submit">
              <span class="en">Send message</span>
              <span class="ja">送信する</span>
            </button>
            <p id="contact-status" class="form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </div>

    <footer>
      &copy; {new Date().getFullYear()} Junko Tsuruoka. All rights reserved.
    </footer>

    <script is:inline>
      function setLang(lang) {
        document.body.className = 'lang-' + lang;
        document.documentElement.lang = lang === 'ja' ? 'ja' : 'en';
        document.getElementById('btn-en').classList.toggle('active', lang === 'en');
        document.getElementById('btn-ja').classList.toggle('active', lang === 'ja');
      }

      const contactForm = document.getElementById('contact-form');
      const contactSubmit = document.getElementById('contact-submit');
      const contactStatus = document.getElementById('contact-status');
      const contactEndpoint = 'https://contact-api.appletree1012.workers.dev';

      contactForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const isJapanese = document.body.classList.contains('lang-ja');
        const formData = new FormData(contactForm);
        const turnstileToken = formData.get('cf-turnstile-response');

        if (!turnstileToken) {
          contactStatus.textContent = isJapanese
            ? '「私は人間です」の確認を完了してください。'
            : 'Please complete the verification.';
          contactStatus.className = 'form-status error';
          return;
        }

        contactSubmit.disabled = true;
        contactStatus.textContent = isJapanese ? '送信中です…' : 'Sending…';
        contactStatus.className = 'form-status';

        try {
          const response = await fetch(contactEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: formData.get('name'),
              email: formData.get('email'),
              message: formData.get('message'),
              website: formData.get('website'),
              turnstileToken,
            }),
          });

          const result = await response.json();
          if (!response.ok) {
            throw new Error(result.error || 'Send failed');
          }

          contactForm.reset();
          contactStatus.textContent = isJapanese
            ? 'お問い合わせを送信しました。ありがとうございます。'
            : 'Your message has been sent. Thank you.';
          contactStatus.className = 'form-status success';
        } catch (error) {
          contactStatus.textContent = isJapanese
            ? '送信できませんでした。時間をおいて再度お試しください。'
            : 'The message could not be sent. Please try again later.';
          contactStatus.className = 'form-status error';
        } finally {
          contactSubmit.disabled = false;
          if (window.turnstile) {
            window.turnstile.reset();
          }
        }
      });
    </script>
  </body>
</html>
