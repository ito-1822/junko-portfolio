---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getBlogs, type Blog } from "../../lib/microcms";

export async function getStaticPaths() {
  const blogs = await getBlogs();

  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

interface Props {
  blog: Blog;
}

const { blog } = Astro.props;

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(new Date(date));
---

<BlogLayout title={`${blog.title} | Junko Tsuruoka`}>
  <article class="article">
    <a class="back-link" href="/blog">← ブログ一覧へ</a>

    <header class="article-header">
      <div class="article-meta">
        <time datetime={blog.publishedAt}>{formatDate(blog.publishedAt)}</time>
        {
          blog.category && (
            <span>{blog.category.name || blog.category.id}</span>
          )
        }
      </div>
      <h1>{blog.title}</h1>
    </header>

    {
      blog.eyecatch && (
        <img
          class="eyecatch"
          src={blog.eyecatch.url}
          alt=""
          width={blog.eyecatch.width}
          height={blog.eyecatch.height}
        />
      )
    }

    <div class="article-body" set:html={blog.content} />
  </article>
</BlogLayout>

<style is:global>
  .article {
    max-width: 760px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 34px;
    color: #666666;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: #222222;
  }

  .article-header {
    margin-bottom: 34px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 12px;
    color: #777777;
    font-size: 0.85rem;
  }

  .article h1 {
    margin: 0;
    font-size: clamp(1.8rem, 6vw, 2.8rem);
    line-height: 1.4;
  }

  .eyecatch {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    margin-bottom: 44px;
    border-radius: 10px;
    object-fit: cover;
  }

  .article-body {
    font-size: 1rem;
    line-height: 2;
  }

  .article-body h2 {
    margin: 2.5em 0 0.8em;
    padding-bottom: 0.35em;
    border-bottom: 1px solid #dddddd;
    font-size: 1.55rem;
    line-height: 1.5;
  }

  .article-body h3 {
    margin: 2em 0 0.7em;
    font-size: 1.25rem;
  }

  .article-body p,
  .article-body ul,
  .article-body ol,
  .article-body blockquote {
    margin: 0 0 1.5em;
  }

  .article-body img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .article-body a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .article-body blockquote {
    padding: 16px 20px;
    border-left: 4px solid #cccccc;
    background: #f5f5f5;
    color: #555555;
  }

  .article-body pre {
    overflow-x: auto;
    padding: 18px;
    border-radius: 6px;
    background: #222222;
    color: #ffffff;
  }
</style>
