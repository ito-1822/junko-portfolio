---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getBlogs } from "../../lib/microcms";

const blogs = await getBlogs();

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("ja-JP", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(new Date(date));
---

<BlogLayout title="Blog | Junko Tsuruoka">
  <header class="page-heading">
    <p class="eyebrow">BLOG</p>
    <h1>ブログ</h1>
    <p>Web制作、ローカライズ、日々の学びを発信します。</p>
  </header>

  {
    blogs.length === 0 ? (
      <p class="empty-message">記事を準備中です。</p>
    ) : (
      <div class="post-grid">
        {blogs.map((blog) => (
          <article class="post-card">
            <a href={`/blog/${blog.id}`}>
              {blog.eyecatch && (
                <img
                  src={blog.eyecatch.url}
                  alt=""
                  width={blog.eyecatch.width}
                  height={blog.eyecatch.height}
                />
              )}
              <div class="post-card-body">
                <div class="post-meta">
                  <time datetime={blog.publishedAt}>{formatDate(blog.publishedAt)}</time>
                  {blog.category && (
                    <span>{blog.category.name || blog.category.id}</span>
                  )}
                </div>
                <h2>{blog.title}</h2>
              </div>
            </a>
          </article>
        ))}
      </div>
    )
  }
</BlogLayout>

<style>
  .page-heading {
    margin-bottom: 44px;
  }

  .eyebrow {
    margin: 0 0 4px;
    color: #777777;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0 0 10px;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.3;
  }

  .page-heading > p:last-child,
  .empty-message {
    margin: 0;
    color: #666666;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .post-card {
    overflow: hidden;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    background: #ffffff;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.07);
  }

  .post-card a {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .post-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #f0f0f0;
  }

  .post-card-body {
    padding: 22px;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin-bottom: 10px;
    color: #777777;
    font-size: 0.78rem;
  }

  .post-card h2 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  @media (max-width: 680px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
